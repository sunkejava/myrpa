{
  "riskLevel": "High",
  "requiresApproval": true,
  "steps": [
    {
      "id": "open",
      "type": "Navigate",
      "config": {
        "url": "{{mockBaseUrl}}/mock/qd-social-security"
      }
    },
    {
      "id": "account",
      "type": "Input",
      "config": {
        "selector": "[name=username]",
        "value": "demo"
      }
    },
    {
      "id": "password",
      "type": "Input",
      "config": {
        "selector": "[name=password]",
        "value": "Demo123!"
      }
    },
    {
      "id": "login",
      "type": "Click",
      "config": {
        "selector": "button[type=submit]"
      }
    },
    {
      "id": "form",
      "type": "WaitForElement",
      "config": {
        "selector": "[name=operation]"
      }
    },
    {
      "id": "operation",
      "type": "Select",
      "config": {
        "selector": "[name=operation]",
        "value": "remove"
      }
    },
    {
      "id": "name",
      "type": "Input",
      "config": {
        "selector": "[name=employeeName]",
        "value": "{{employeeName}}"
      }
    },
    {
      "id": "id",
      "type": "Input",
      "config": {
        "selector": "[name=idNumber]",
        "value": "{{idNumber}}"
      }
    },
    {
      "id": "submit",
      "type": "Click",
      "config": {
        "selector": "button[type=submit]"
      }
    },
    {
      "id": "result",
      "type": "Assert",
      "config": {
        "selector": "[data-result=success]",
        "contains": "减员申报成功"
      }
    }
  ]
}
