{
  "riskLevel": "High",
  "requiresApproval": true,
  "steps": [
    {
      "id": "open",
      "type": "Navigate",
      "config": {
        "url": "{{mockBaseUrl}}/mock/qd-social-security"
      }
    },
    {
      "id": "account",
      "type": "Input",
      "config": {
        "selector": "[name=username]",
        "value": "demo"
      }
    },
    {
      "id": "password",
      "type": "Input",
      "config": {
        "selector": "[name=password]",
        "value": "Demo123!"
      }
    },
    {
      "id": "login",
      "type": "Click",
      "config": {
        "selector": "button[type=submit]"
      }
    },
    {
      "id": "form",
      "type": "WaitForElement",
      "config": {
        "selector": "[name=operation]"
      }
    },
    {
      "id": "operation",
      "type": "Select",
      "config": {
        "selector": "[name=operation]",
        "value": "add"
      }
    },
    {
      "id": "name",
      "type": "Input",
      "config": {
        "selector": "[name=employeeName]",
        "value": "{{employeeName}}"
      }
    },
    {
      "id": "id",
      "type": "Input",
      "config": {
        "selector": "[name=idNumber]",
        "value": "{{idNumber}}"
      }
    },
    {
      "id": "submit",
      "type": "Click",
      "config": {
        "selector": "button[type=submit]"
      }
    },
    {
      "id": "result",
      "type": "Assert",
      "config": {
        "selector": "[data-result=success]",
        "contains": "增员申报成功"
      }
    }
  ],
  "parameters": {
    "mockBaseUrl": {
      "type": "string",
      "required": true,
      "minLength": 10,
      "maxLength": 2048
    },
    "employeeName": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 40
    },
    "idNumber": {
      "type": "string",
      "required": true,
      "minLength": 18,
      "maxLength": 18,
      "sensitive": true
    }
  }
}
