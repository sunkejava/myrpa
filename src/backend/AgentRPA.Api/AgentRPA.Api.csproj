<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentRPA.Application\AgentRPA.Application.csproj" />
    <ProjectReference Include="..\AgentRPA.Infrastructure\AgentRPA.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../docs/examples/modelscope-gguf-download.json" LogicalName="ModelDownload.Workflow.json" />
    <EmbeddedResource Include="../../../docs/examples/model-download-template.xlsx" LogicalName="ModelDownload.Template.xlsx" />
  </ItemGroup>
</Project>
